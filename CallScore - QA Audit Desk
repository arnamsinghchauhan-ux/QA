<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Space Strike 🚀</title>

<style>
*{
    box-sizing:border-box;
    margin:0;
    padding:0;
}

body{
    overflow:hidden;
    background:#02030a;
    font-family:Arial,sans-serif;
    color:white;
}

canvas{
    display:block;
    width:100vw;
    height:100vh;
    background:
        radial-gradient(circle at 50% 40%, #101735 0%, #030510 55%, #000 100%);
}

#hud{
    position:fixed;
    top:18px;
    left:20px;
    right:20px;
    display:flex;
    justify-content:space-between;
    pointer-events:none;
    z-index:5;
}

.panel{
    background:rgba(10,15,35,.75);
    border:1px solid rgba(255,255,255,.15);
    padding:10px 16px;
    border-radius:12px;
    backdrop-filter:blur(8px);
    font-weight:bold;
}

#healthOuter{
    width:160px;
    height:10px;
    background:#222;
    border-radius:10px;
    overflow:hidden;
    margin-top:6px;
}

#health{
    height:100%;
    width:100%;
    background:#32e875;
    transition:.2s;
}

#bossBar{
    position:fixed;
    top:82px;
    left:50%;
    transform:translateX(-50%);
    width:min(500px,75vw);
    display:none;
    z-index:6;
}

#bossTitle{
    text-align:center;
    font-weight:bold;
    color:#ff5757;
    margin-bottom:5px;
}

#bossOuter{
    height:14px;
    background:#250909;
    border:1px solid #ff4444;
    border-radius:20px;
    overflow:hidden;
}

#bossHealth{
    width:100%;
    height:100%;
    background:#ff3030;
}

#menu,
#gameOver{
    position:fixed;
    inset:0;
    display:flex;
    justify-content:center;
    align-items:center;
    background:rgba(0,0,0,.65);
    backdrop-filter:blur(8px);
    z-index:10;
}

.card{
    width:min(430px,90%);
    padding:38px;
    text-align:center;
    border-radius:25px;
    background:linear-gradient(145deg,#111a3d,#080b1d);
    border:1px solid rgba(255,255,255,.15);
    box-shadow:0 25px 80px rgba(0,0,0,.6);
}

h1{
    font-size:46px;
    margin-bottom:10px;
}

.subtitle{
    color:#9ca7c9;
    margin-bottom:25px;
}

button{
    border:0;
    padding:14px 35px;
    border-radius:30px;
    background:#5d6cff;
    color:white;
    font-size:17px;
    font-weight:bold;
    cursor:pointer;
    box-shadow:0 8px 25px rgba(93,108,255,.35);
}

button:hover{
    transform:translateY(-2px);
    background:#7280ff;
}

.hidden{
    display:none !important;
}

.controls{
    margin-top:22px;
    font-size:13px;
    color:#7883a5;
    line-height:1.8;
}

#combo{
    position:fixed;
    left:50%;
    top:28%;
    transform:translate(-50%,-50%);
    font-size:30px;
    font-weight:bold;
    color:#ffe66d;
    opacity:0;
    pointer-events:none;
}

#levelUp{
    position:fixed;
    left:50%;
    top:45%;
    transform:translate(-50%,-50%);
    font-size:42px;
    font-weight:bold;
    color:#61dafb;
    opacity:0;
    pointer-events:none;
}
</style>
</head>

<body>

<canvas id="game"></canvas>

<div id="hud">
    <div class="panel">
        🚀 SCORE: <span id="score">0</span><br>
        🌊 WAVE: <span id="wave">1</span>
    </div>

    <div class="panel">
        ❤️ <span id="healthText">100</span>
        <div id="healthOuter">
            <div id="health"></div>
        </div>
    </div>
</div>

<div id="bossBar">
    <div id="bossTitle">☠️ BOSS</div>
    <div id="bossOuter">
        <div id="bossHealth"></div>
    </div>
</div>

<div id="combo"></div>
<div id="levelUp"></div>

<div id="menu">
    <div class="card">
        <h1>🚀</h1>
        <h2>SPACE STRIKE</h2>
        <p class="subtitle">
            Destroy the fleet. Survive the waves. Defeat the boss.
        </p>

        <button onclick="startGame()">START MISSION</button>

        <div class="controls">
            ⌨️ Move: WASD / Arrow Keys<br>
            🔫 Shoot: SPACE<br>
            🖱️ Mouse: Move + Hold Click to Fire
        </div>
    </div>
</div>

<div id="gameOver" class="hidden">
    <div class="card">
        <h1>💥</h1>
        <h2>MISSION FAILED</h2>
        <p class="subtitle">
            Final Score: <strong id="finalScore">0</strong>
        </p>

        <button onclick="startGame()">RESTART</button>
    </div>
</div>

<script>

const canvas = document.getElementById("game");
const ctx = canvas.getContext("2d");

let W,H;

function resize(){
    W = canvas.width = window.innerWidth * devicePixelRatio;
    H = canvas.height = window.innerHeight * devicePixelRatio;
    canvas.style.width = window.innerWidth+"px";
    canvas.style.height = window.innerHeight+"px";
    ctx.setTransform(1,0,0,1,0,0);
    ctx.scale(devicePixelRatio,devicePixelRatio);
    W = window.innerWidth;
    H = window.innerHeight;
}

window.addEventListener("resize",resize);
resize();

let player;
let bullets=[];
let enemies=[];
let enemyBullets=[];
let particles=[];
let stars=[];
let powerups=[];

let score=0;
let wave=1;
let health=100;
let running=false;

let keys={};
let mouse={
    x:W/2,
    y:H-100,
    down:false
};

let spawnTimer=0;
let waveTimer=0;
let boss=null;
let bossActive=false;
let combo=0;
let comboTimer=0;

for(let i=0;i<130;i++){
    stars.push({
        x:Math.random()*W,
        y:Math.random()*H,
        speed:Math.random()*2+0.4,
        size:Math.random()*2+0.5
    });
}

document.addEventListener("keydown",e=>{
    keys[e.key.toLowerCase()]=true;

    if(e.code==="Space"){
        keys.space=true;
        e.preventDefault();
    }
});

document.addEventListener("keyup",e=>{
    keys[e.key.toLowerCase()]=false;

    if(e.code==="Space"){
        keys.space=false;
    }
});

canvas.addEventListener("mousemove",e=>{
    mouse.x=e.clientX;
    mouse.y=e.clientY;
});

canvas.addEventListener("mousedown",()=>{
    mouse.down=true;
});

canvas.addEventListener("mouseup",()=>{
    mouse.down=false;
});

function startGame(){

    document.getElementById("menu").classList.add("hidden");
    document.getElementById("gameOver").classList.add("hidden");

    score=0;
    wave=1;
    health=100;
    bullets=[];
    enemies=[];
    enemyBullets=[];
    particles=[];
    powerups=[];
    boss=null;
    bossActive=false;
    combo=0;
    waveTimer=0;
    spawnTimer=0;

    player={
        x:W/2,
        y:H-100,
        size:20,
        speed:7,
        cooldown:0,
        shield:0
    };

    running=true;

    document.getElementById("bossBar").style.display="none";

    requestAnimationFrame(loop);
}

function shoot(){

    if(player.cooldown>0) return;

    bullets.push({
        x:player.x,
        y:player.y-25,
        vx:0,
        vy:-11,
        damage:1
    });

    player.cooldown=9;
}

function enemyShoot(enemy){

    let angle=Math.atan2(
        player.y-enemy.y,
        player.x-enemy.x
    );

    enemyBullets.push({
        x:enemy.x,
        y:enemy.y+15,
        vx:Math.cos(angle)*4,
        vy:Math.sin(angle)*4,
        r:4
    });
}

function spawnEnemy(){

    const type=Math.random();

    let enemy;

    if(type<0.65){

        enemy={
            x:Math.random()*(W-60)+30,
            y:-40,
            w:30,
            h:25,
            hp:1,
            speed:1.5+wave*.08,
            shoot:Math.random()*120+80,
            type:"normal"
        };

    }else{

        enemy={
            x:Math.random()*(W-70)+35,
            y:-50,
            w:42,
            h:34,
            hp:3,
            speed:1+wave*.05,
            shoot:Math.random()*100+60,
            type:"heavy"
        };
    }

    enemies.push(enemy);
}

function spawnBoss(){

    bossActive=true;

    boss={
        x:W/2,
        y:120,
        w:100,
        h:70,
        hp:80+wave*15,
        maxHp:80+wave*15,
        vx:3,
        shoot:40
    };

    document.getElementById("bossBar").style.display="block";
}

function createExplosion(x,y,count=12){

    for(let i=0;i<count;i++){

        let angle=Math.random()*Math.PI*2;
        let speed=Math.random()*5+1;

        particles.push({
            x,y,
            vx:Math.cos(angle)*speed,
            vy:Math.sin(angle)*speed,
            life:35+Math.random()*25,
            size:Math.random()*4+1
        });
    }
}

function updatePlayer(){

    if(keys.arrowleft || keys.a)
        player.x-=player.speed;

    if(keys.arrowright || keys.d)
        player.x+=player.speed;

    if(keys.arrowup || keys.w)
        player.y-=player.speed;

    if(keys.arrowdown || keys.s)
        player.y+=player.speed;

    if(mouse.down){
        player.x += (mouse.x-player.x)*0.15;
        player.y += (mouse.y-player.y)*0.15;
        shoot();
    }

    if(keys.space) shoot();

    player.x=Math.max(25,Math.min(W-25,player.x));
    player.y=Math.max(50,Math.min(H-35,player.y));

    if(player.cooldown>0)
        player.cooldown--;
}

function updateBullets(){

    bullets.forEach(b=>{
        b.x+=b.vx;
        b.y+=b.vy;
    });

    bullets=bullets.filter(b=>b.y>-30);
}

function updateEnemies(){

    enemies.forEach(e=>{

        e.y+=e.speed;

        e.x += Math.sin(e.y*.02)*0.6;

        e.shoot--;

        if(e.shoot<=0){

            enemyShoot(e);

            e.shoot=
                e.type==="heavy"
                ? 90+Math.random()*80
                : 120+Math.random()*100;
        }

        if(e.y>H+60){

            e.y=-50;

            damagePlayer(8);
        }
    });
}

function updateEnemyBullets(){

    enemyBullets.forEach(b=>{
        b.x+=b.vx;
        b.y+=b.vy;
    });

    enemyBullets=enemyBullets.filter(
        b=>b.x>-20 &&
        b.x<W+20 &&
        b.y>-20 &&
        b.y<H+20
    );
}

function updateBoss(){

    if(!boss) return;

    boss.x+=boss.vx;

    if(boss.x<70 || boss.x>W-70)
        boss.vx*=-1;

    boss.shoot--;

    if(boss.shoot<=0){

        for(let i=-2;i<=2;i++){

            enemyBullets.push({
                x:boss.x,
                y:boss.y+30,
                vx:i*1.5,
                vy:4,
                r:5
            });
        }

        boss.shoot=45;
    }

    document.getElementById("bossHealth").style.width =
        Math.max(0,boss.hp/boss.maxHp*100)+"%";
}

function collision(a,b){

    return Math.abs(a.x-b.x) <
        (a.size || a.r || a.w/2)+(b.size || b.r || b.w/2)
    &&
    Math.abs(a.y-b.y) <
        (a.size || a.r || a.h/2)+(b.size || b.r || b.h/2);
}

function damagePlayer(amount){

    if(player.shield>0){

        player.shield-=amount;

        if(player.shield<0){
            health+=player.shield;
            player.shield=0;
        }

    }else{
        health-=amount;
    }

    health=Math.max(0,health);

    if(health<=0)
        endGame();
}

function updateCollisions(){

    // player bullets vs enemies

    for(let i=bullets.length-1;i>=0;i--){

        for(let j=enemies.length-1;j>=0;j--){

            if(collision(bullets[i],enemies[j])){

                let e=enemies[j];

                e.hp--;

                bullets.splice(i,1);

                createExplosion(
                    e.x,
                    e.y,
                    e.hp<=0?15:5
                );

                if(e.hp<=0){

                    score += e.type==="heavy" ? 30 : 10;

                    combo++;
                    comboTimer=120;

                    if(Math.random()<0.08)
                        powerups.push({
                            x:e.x,
                            y:e.y,
                            type:Math.random()<0.5?"health":"shield"
                        });

                    enemies.splice(j,1);
                }

                break;
            }
        }
    }

    // bullets vs boss

    if(boss){

        for(let i=bullets.length-1;i>=0;i--){

            if(collision(bullets[i],boss)){

                boss.hp-=bullets[i].damage;

                bullets.splice(i,1);

                createExplosion(
                    boss.x+Math.random()*60-30,
                    boss.y+Math.random()*40-20,
                    4
                );

                if(boss.hp<=0){

                    score+=500;

                    createExplosion(
                        boss.x,
                        boss.y,
                        80
                    );

                    boss=null;
                    bossActive=false;

                    document.getElementById("bossBar")
                        .style.display="none";

                    health=Math.min(100,health+25);

                    showText("BOSS DESTROYED! +500");
                }
            }
        }
    }

    // enemy bullets vs player

    for(let i=enemyBullets.length-1;i>=0;i--){

        if(collision(enemyBullets[i],player)){

            enemyBullets.splice(i,1);

            damagePlayer(10);

            createExplosion(player.x,player.y,8);
        }
    }

    // enemies vs player

    for(let i=enemies.length-1;i>=0;i--){

        if(collision(enemies[i],player)){

            createExplosion(
                enemies[i].x,
                enemies[i].y,
                20
            );

            enemies.splice(i,1);

            damagePlayer(20);
        }
    }

    // powerups

    for(let i=powerups.length-1;i>=0;i--){

        let p=powerups[i];

        p.y+=2;

        if(collision(p,player)){

            if(p.type==="health"){
                health=Math.min(100,health+20);
                showText("❤️ HEALTH +20");
            }else{
                player.shield=40;
                showText("🛡️ SHIELD");
            }

            powerups.splice(i,1);
        }
    }
}

function updateParticles(){

    particles.forEach(p=>{
        p.x+=p.vx;
        p.y+=p.vy;
        p.vx*=.98;
        p.vy*=.98;
        p.life--;
    });

    particles=particles.filter(p=>p.life>0);
}

function updateStars(){

    stars.forEach(s=>{

        s.y+=s.speed*(1+wave*.05);

        if(s.y>H){
            s.y=0;
            s.x=Math.random()*W;
        }
    });
}

function updateWave(){

    waveTimer++;

    if(
        waveTimer>900 &&
        !bossActive &&
        !boss
    ){

        wave++;

        waveTimer=0;

        showText("WAVE "+wave);

        if(wave%5===0){

            enemies=[];

            spawnBoss();

        }
    }

    spawnTimer--;

    if(
        spawnTimer<=0 &&
        !bossActive
    ){

        spawnEnemy();

        spawnTimer=
            Math.max(
                20,
                65-wave*3
            );
    }
}

function showText(text){

    const el=document.getElementById("levelUp");

    el.textContent=text;
    el.style.opacity=1;

    setTimeout(()=>{
        el.style.opacity=0;
    },900);
}

function drawStars(){

    ctx.fillStyle="white";

    stars.forEach(s=>{
        ctx.globalAlpha=.3+s.size*.2;
        ctx.fillRect(
            s.x,
            s.y,
            s.size,
            s.size
        );
    });

    ctx.globalAlpha=1;
}

function drawPlayer(){

    ctx.save();

    ctx.translate(player.x,player.y);

    // glow

    ctx.shadowBlur=25;
    ctx.shadowColor="#5d7cff";

    ctx.fillStyle="#6f8cff";

    ctx.beginPath();

    ctx.moveTo(0,-28);
    ctx.lineTo(20,22);
    ctx.lineTo(0,14);
    ctx.lineTo(-20,22);

    ctx.closePath();
    ctx.fill();

    ctx.shadowBlur=0;

    // cockpit

    ctx.fillStyle="#a9f1ff";

    ctx.beginPath();
    ctx.arc(0,-7,7,0,Math.PI*2);
    ctx.fill();

    // engine

    ctx.fillStyle="#ffb84d";

    ctx.beginPath();
    ctx.moveTo(-7,18);
    ctx.lineTo(0,35+Math.random()*8);
    ctx.lineTo(7,18);
    ctx.fill();

    // shield

    if(player.shield>0){

        ctx.strokeStyle="#45e9ff";
        ctx.lineWidth=3;
        ctx.beginPath();
        ctx.arc(0,0,34,0,Math.PI*2);
        ctx.stroke();
    }

    ctx.restore();
}

function drawEnemy(e){

    ctx.save();

    ctx.translate(e.x,e.y);

    ctx.shadowBlur=18;
    ctx.shadowColor="#ff394f";

    ctx.fillStyle=
        e.type==="heavy"
        ? "#c33bff"
        : "#ff4058";

    ctx.beginPath();

    ctx.moveTo(0,25);
    ctx.lineTo(30,-15);
    ctx.lineTo(10,-10);
    ctx.lineTo(0,-25);
    ctx.lineTo(-10,-10);
    ctx.lineTo(-30,-15);

    ctx.closePath();

    ctx.fill();

    ctx.shadowBlur=0;

    ctx.restore();
}

function drawBoss(){

    if(!boss) return;

    ctx.save();

    ctx.translate(boss.x,boss.y);

    ctx.shadowBlur=35;
    ctx.shadowColor="#ff2020";

    ctx.fillStyle="#8d1524";

    ctx.beginPath();

    ctx.moveTo(0,-40);
    ctx.lineTo(65,25);
    ctx.lineTo(30,20);
    ctx.lineTo(0,40);
    ctx.lineTo(-30,20);
    ctx.lineTo(-65,25);

    ctx.closePath();

    ctx.fill();

    ctx.shadowBlur=0;

    ctx.fillStyle="#ff5a5a";

    ctx.beginPath();
    ctx.arc(0,0,15,0,Math.PI*2);
    ctx.fill();

    ctx.restore();
}

function drawBullets(){

    bullets.forEach(b=>{

        ctx.fillStyle="#6dfcff";

        ctx.shadowBlur=15;
        ctx.shadowColor="#6dfcff";

        ctx.fillRect(
            b.x-2,
            b.y-10,
            4,
            15
        );
    });

    ctx.shadowBlur=0;

    enemyBullets.forEach(b=>{

        ctx.fillStyle="#ff4d66";

        ctx.beginPath();
        ctx.arc(b.x,b.y,b.r,0,Math.PI*2);
        ctx.fill();
    });
}

function drawParticles(){

    particles.forEach(p=>{

        ctx.globalAlpha=p.life/60;

        ctx.fillStyle="#ffcc66";

        ctx.beginPath();

        ctx.arc(
            p.x,
            p.y,
            p.size,
            0,
            Math.PI*2
        );

        ctx.fill();
    });

    ctx.globalAlpha=1;
}

function drawPowerups(){

    powerups.forEach(p=>{

        ctx.save();

        ctx.translate(p.x,p.y);

        ctx.fillStyle=
            p.type==="health"
            ? "#42e889"
            : "#42dfff";

        ctx.shadowBlur=20;
        ctx.shadowColor=ctx.fillStyle;

        ctx.beginPath();

        ctx.arc(0,0,12,0,Math.PI*2);

        ctx.fill();

        ctx.shadowBlur=0;

        ctx.fillStyle="#001";

        ctx.font="bold 12px Arial";
        ctx.textAlign="center";
        ctx.textBaseline="middle";

        ctx.fillText(
            p.type==="health"?"♥":"S",
            0,
            1
        );

        ctx.restore();
    });
}

function updateHUD(){

    document.getElementById("score")
        .textContent=score;

    document.getElementById("wave")
        .textContent=wave;

    document.getElementById("healthText")
        .textContent=Math.ceil(health);

    document.getElementById("health")
        .style.width=health+"%";

    if(comboTimer>0){

        comboTimer--;

        const c=document.getElementById("combo");

        if(combo>=3){

            c.textContent=
                "🔥 "+combo+" COMBO";

            c.style.opacity=1;
        }

    }else{

        combo=0;

        document.getElementById("combo")
            .style.opacity=0;
    }
}

function draw(){

    ctx.clearRect(0,0,W,H);

    drawStars();
    drawParticles();

    drawPowerups();

    enemies.forEach(drawEnemy);

    drawBoss();

    drawBullets();

    if(player)
        drawPlayer();

    updateHUD();
}

function loop(){

    if(!running) return;

    updateStars();
    updatePlayer();
    updateBullets();
    updateEnemies();
    updateEnemyBullets();
    updateBoss();
    updateCollisions();
    updateParticles();
    updateWave();

    draw();

    requestAnimationFrame(loop);
}

function endGame(){

    running=false;

    document.getElementById("finalScore")
        .textContent=score;

    document.getElementById("gameOver")
        .classList.remove("hidden");
}

</script>

</body>
</html>
